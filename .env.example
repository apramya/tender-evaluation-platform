# Tender Evaluation Platform - Environment Configuration

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
FRONTEND_URL=http://localhost:3000
AUTO_CREATE_TABLES=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://tender_user:tender_password@localhost:5432/tender_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-12345678

# Groq Configuration
GROQ_API_KEY=gsk-your-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Document Processing
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# Storage Configuration
STORAGE_BACKEND=s3
S3_UPLOAD_ON_REQUEST=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_PREFIX=tender-evaluation

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/oauth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:8000/api/auth/oauth/linkedin/callback

# OCR Configuration
USE_TESSERACT=true
TESSERACT_PATH=/usr/bin/tesseract

# Vector Database
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_SEARCH_ENABLED=true
PROCESS_UPLOADS_ON_REQUEST=false

# Email Configuration
EMAIL_FROM=noreply@tenderevaluation.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENTRY_DSN=

# Public Signup + OTP
ALLOW_PUBLIC_SIGNUP=true
REACT_APP_ALLOW_PUBLIC_SIGNUP=true
PUBLIC_SIGNUP_ALLOWED_EMAILS=
PUBLIC_SIGNUP_ALLOWED_DOMAINS=
PUBLIC_SIGNUP_BLOCKED_EMAILS=
PUBLIC_SIGNUP_BLOCKED_DOMAINS=tempmail.com,10minutemail.com,mailinator.com
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_LENGTH=6

# Confidence Thresholds
MIN_CONFIDENCE_FOR_AUTO_DECISION=0.85
CONFIDENCE_THRESHOLD_MANUAL_REVIEW=0.70
